{
  "name": "@connectingmatrix/ai-agents-advanced",
  "version": "0.1.0",
  "description": "Advanced AI agents derived from core AI agents with planning, research, structured output, and designer helpers.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js"
    },
    "./entity": {
      "types": "./dist/entity/index.d.ts",
      "import": "./dist/entity/index.js"
    },
    "./package.json": "./package.json",
    "./package-structure": {
      "types": "./dist/package-structure.d.ts",
      "import": "./dist/package-structure.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.js"
    },
    "./agents": {
      "types": "./dist/backend/agents/index.d.ts",
      "import": "./dist/backend/agents/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./frontend": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "README.md",
    "tests",
    "vendor",
    "PACKAGE_STRUCTURE.json",
    "PACKAGE_STRUCTURE.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/**/*.test.js",
    "play": "npm run build && node examples/playground.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@connectingmatrix/ai-agents": "file:../ai-agents"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "sideEffects": false,
  "license": "UNLICENSED"
}
